# Copie para .env.production na VPS e ajuste os valores.
# NÃO versionar .env.production com segredos reais.

APP_PORT=3000
DATABASE_URL="file:/app/data/prod.db"

# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-forte"
AUTH_TRUST_HOST="true"

# URL pública do app (domínio ou IP)
AUTH_URL="http://SEU_IP_OU_DOMINIO:3000"

# true = roda seed no primeiro boot (usuários demo). Deixe false após o primeiro uso.
SEED_ON_BOOT="false"
